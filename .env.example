# ──────────────────────────────────────────────────────────────────────────
# VS Mart production environment. Copy to `.env` and fill every CHANGE_ME.
# `.env` is git-ignored — never commit real secrets.
# ──────────────────────────────────────────────────────────────────────────

# ── TLS / ACME ─────────────────────────────────────────────────────────────
# Email Let's Encrypt uses for cert expiry notices.
ACME_EMAIL=admin@thevsmart.com

# ── Postgres ───────────────────────────────────────────────────────────────
POSTGRES_DB=vsmart
POSTGRES_USER=vsmart
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
# Must match the three values above (host is the compose service name `db`).
DATABASE_URL=postgres://vsmart:CHANGE_ME_strong_db_password@db:5432/vsmart

# ── Django core ────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.prod
DEBUG=False
# Generate: python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_long_random_secret
ALLOWED_HOSTS=api.thevsmart.com
CSRF_TRUSTED_ORIGINS=https://api.thevsmart.com
# Web consoles call the API cross-origin from these sites:
CORS_ALLOWED_ORIGINS=https://thevsmart.com,https://www.thevsmart.com,https://admin.thevsmart.com,https://store.thevsmart.com
REDIS_URL=redis://redis:6379/0
ENVIRONMENT=production

# ── Web consoles (BUILD-TIME — baked into the JS bundle; rebuild to change) ──
ADMIN_API_BASE_URL=https://api.thevsmart.com/api/v1
# Store-admin "New Order" web push (closed-tab case) — the Web app's config
# from Firebase Console -> Project Settings -> General -> Your apps. Every
# value is a client-embeddable identifier, never a secret. Leave blank to
# skip: the tab-open alert (WebSocket) works regardless.
STORE_FIREBASE_API_KEY=
STORE_FIREBASE_AUTH_DOMAIN=
STORE_FIREBASE_PROJECT_ID=
STORE_FIREBASE_STORAGE_BUCKET=
STORE_FIREBASE_MESSAGING_SENDER_ID=
STORE_FIREBASE_APP_ID=
# Cloud Messaging -> Web Push certificates -> "Key pair".
STORE_FIREBASE_VAPID_KEY=

# ── Auth / OTP ─────────────────────────────────────────────────────────────
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=30
# Demo login: this OTP always verifies for any phone. Keep 123456 if you want the
# demo login to work; set blank to require real SMS OTP only.
OTP_DEV_BYPASS_CODE=123456
# SMS gateway: "console" logs the OTP to the backend log (dev/demo); "msg91" sends real SMS.
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# ── Payments (Razorpay) ────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Push (FCM) ─────────────────────────────────────────────────────────────
FCM_SERVER_KEY=
# Where a web-push notification's click should land (store-admin panel).
STORE_ADMIN_URL=https://store.thevsmart.com

# ── Email (password reset, transactional) ──────────────────────────────────
# Leave EMAIL_HOST blank → console backend (reset codes print to the backend log).
# Set EMAIL_HOST/USER/PASSWORD → real SMTP (e.g. SendGrid, SES, Gmail app password).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=VS Mart <no-reply@thevsmart.com>

# ── Error monitoring (optional) ────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Pricing knobs (optional — sensible defaults exist in settings) ──────────
# GST_RATE=0.05
# DELIVERY_FEE=20
# FREE_DELIVERY_THRESHOLD=499
# RESERVATION_TTL_MINUTES=15
