<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Delivery: live GPS for the geofence + breadcrumb, and the camera for POD. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- On-duty presence (background_service.dart): a persistent foreground
         service keeps posting the agent's location to dispatch even if the
         app is swiped away, not just backgrounded. ACCESS_BACKGROUND_LOCATION
         is what actually allows a GPS fix once there's no foreground Activity
         — Android treats a foreground SERVICE alone as "background" for
         location purposes. Requesting it triggers Android's own "Allow all
         the time" runtime dialog; the service still runs (with a stale/no fix)
         if the agent only grants "while using the app". -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <!-- Push: runtime notification permission on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- The full-screen "new task" alert (see push_service.dart /
         incoming_task_screen.dart) — lets a high-importance notification wake
         and launch the app over the lock screen, like an incoming call. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
        <!-- Android 11+ package-visibility: without this, url_launcher can't see
             ANY browser (even an installed Chrome) to open a Custom Tab in, so
             LaunchMode.inAppBrowserView silently falls through to its external
             fallback — the Razorpay hand-over link opened outside the app. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <category android:name="android.intent.category.BROWSABLE"/>
            <data android:scheme="https"/>
        </intent>
        <!-- google.navigation: (active_delivery_map_screen.dart / batch_route_screen.dart
             _navigate) launches TRUE turn-by-turn in Google Maps. Without this
             package-visibility entry, canLaunchUrl on that scheme is always false
             on Android 11+ regardless of whether Maps is installed — every tap
             silently degraded to the plain "open a maps URL" web fallback, never
             the actual navigation app. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="google.navigation"/>
        </intent>
    </queries>
    <application
        android:label="VS Mart Agent"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">
        <!-- Google Maps (embedded route map). Requires a "Maps SDK for Android" key
             injected via the ${MAPS_API_KEY} placeholder (android/local.properties or
             the MAPS_API_KEY env var). Until set, the map renders blank. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}"/>
        <!-- FCM branding for background/terminated notifications (Android renders
             those itself; our Dart handler only runs in the foreground). Icon is a
             white silhouette; the accent tints it. Fallback channel matches the
             backend's DEFAULT_CHANNEL (notifications/push.py). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification"/>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent"/>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="vsmart_support"/>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- flutter_background_service's own manifest declares this service with
             no foregroundServiceType — Android 14+ throws
             MissingForegroundServiceTypeException at startForeground() unless the
             type it's actually started with (location — set in
             background_service.dart's AndroidConfiguration) is ALSO declared
             here. This overrides that plugin-bundled entry via manifest merging
             (same fully-qualified service name). -->
        <service
            android:name="id.flutter.flutter_background_service.BackgroundService"
            android:foregroundServiceType="location"
            android:exported="true"
            android:stopWithTask="false" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
