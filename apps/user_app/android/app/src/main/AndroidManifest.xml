<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Networking -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- KYC documents & selfie -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <!-- Delivery address / GPS -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <application
        android:label="VS Mart"
        android:name="${applicationName}"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher">
        <!-- Google Maps (order tracking). REPLACE the value below with your own
             "Maps SDK for Android" API key from Google Cloud Console (enable the
             API + billing on the project). Until then the map renders blank. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}"/>
        <!-- Branded push: default small icon, accent color and fallback channel
             for FCM notifications the system renders while the app is in the
             background/terminated (our Dart handler only runs in foreground).
             The channel id MUST match one created in push_controller.dart. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification"/>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent"/>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="vsmart_support"/>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Explicitly OFF so there is exactly one deep-link path. Flutter's
                 built-in handling would hand the URL straight to go_router as the
                 initial location, where the splash/auth/serviceability gates
                 discard it. app_links delivers it to DeepLinkController instead,
                 which parks it until those gates settle. -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- App Links: https://thevsmart.com/products/<shareToken> opens the
                 product in the app instead of the browser. `autoVerify` makes
                 Android fetch https://thevsmart.com/.well-known/assetlinks.json at
                 install time and check this app's signing fingerprint against it —
                 until that file lists the PLAY APP-SIGNING SHA-256, verification
                 fails and links keep opening in the browser (no crash, just no
                 interception). Verify with:
                   adb shell pm get-app-links com.vsmart.user_app
                 Path-scoped on purpose: we only claim the URLs we publish, so the
                 marketing pages, /privacy and /terms stay in the browser. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="thevsmart.com"/>
                <data android:scheme="https" android:host="www.thevsmart.com"/>
                <data android:pathPrefix="/products/"/>
                <data android:pathPrefix="/product/"/>
            </intent-filter>

            <!-- Custom scheme, unverified by design: a fallback for contexts that
                 can't use an https link. Any app can claim this, so treat links
                 arriving here as untrusted — `resolveDeepLink` allowlists the
                 shapes it will act on. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="vsmart"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- So canLaunchUrl(tel:) resolves on Android 11+ (package visibility):
             lets the customer dial the delivery rider from order tracking. -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
    </queries>
</manifest>
