# ── Django ───────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=dev-only-change-in-prod
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,api.vsmart.app

# ── Database ─────────────────────────────────────────────
POSTGRES_DB=vsmart
POSTGRES_USER=vsmart
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://vsmart:change-me@db:5432/vsmart

# ── Redis (cache / broker / OTP / rate-limit) ────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# ── JWT ──────────────────────────────────────────────────
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=30

# ── Object storage (MinIO in dev, R2/S3 in prod) ─────────
S3_ENDPOINT=http://minio:9000
S3_BUCKET=vsmart-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── SMS (OTP) — use console backend in dev ───────────────
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=VSMART

# ── Payments (Razorpay) ──────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── KYC / identity verification ──────────────────────────
# Blank/unset → the bundled MOCK verifier runs the whole flow (dev/CI need no keys).
# Set KYC_PROVIDER=signzy (recommended) or =setu to go live, then fill that block.
KYC_PROVIDER=
# Signzy (https://api.signzy.app; sandbox https://api-preproduction.signzy.app).
# Use EITHER a static API key OR username/password (patron-login token).
SIGNZY_BASE_URL=https://api.signzy.app
SIGNZY_API_KEY=
SIGNZY_USERNAME=
SIGNZY_PASSWORD=
# Cashfree "Secure ID" (KYC_PROVIDER=cashfree). Requires the Verification Suite
# product to be ENABLED on the account — plain Payment-Gateway keys won't reach
# /verification/*. App Id + Secret Key from the Cashfree dashboard.
CASHFREE_BASE_URL=https://api.cashfree.com/verification
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2022-10-26
# Setu (alternative provider). Per-product instance ids come from the Setu dashboard.
SETU_BASE_URL=https://prod.setu.co
SETU_DG_BASE_URL=https://dg.setu.co
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_PAN_PRODUCT_ID=
SETU_DIGILOCKER_PRODUCT_ID=
SETU_AADHAAR_PRODUCT_ID=
SETU_BANK_PRODUCT_ID=

# ── Business rules (match the app) ───────────────────────
GST_RATE=0.18
FREE_DELIVERY_THRESHOLD=499
DELIVERY_FEE=45
CURRENCY=INR

# ── Google Maps SERVER key (backend /geo proxy) ──────────
# Powers reverse-geocoding + Places autocomplete/detail used by the customer app
# and the admin store-location search. This is a SERVER/web-service key — it must
# NOT be HTTP-referrer or app restricted (those are rejected by Google web services).
# Restrict by IP (your server) instead. Can also be set at runtime in the
# super-admin panel (Integration Settings > google_maps_key), which overrides this.
GOOGLE_MAPS_API_KEY=

# Credit bureau (Payon) — CIBIL score pull by mobile. Use the RESELLER host:
# the bare apipayon.in host rejects reseller keys with "Invalid API key".
CREDIT_BUREAU_BASE_URL=https://reseller.apipayon.in/api/v1/serv2/check_credit_score.php
CREDIT_BUREAU_API_KEY=your-payon-api-key
