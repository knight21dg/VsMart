# Secrets — never commit
.env
*.env
.env.local
.env*.local
!.env.example

# Secrets — SSH. A stray `~` directory gets created in the repo root because Git
# Bash's HOME is corrupted on the dev machine; the production deploy key landed
# in it and was committed. Never again.
~/
.ssh/
id_rsa*
id_ed25519*
*_deploy
*_deploy.pub

# Secrets — Android release signing. The upload keystore IS the app's identity
# on Play: whoever holds it can ship an update. Keep it off the repo and in the
# password manager / CI secret store.
*.jks
*.keystore
key.properties

# Python / Django
__pycache__/
*.py[cod]
.venv/
venv/
db.sqlite3
db.sqlite3-journal
apps/backend/media/
apps/backend/staticfiles/
.pytest_cache/
.coverage
htmlcov/

# Node / Next.js
node_modules/
.next/
npm-debug.log*
yarn-error.log*

# Flutter
**/.dart_tool/
**/build/
**/.flutter-plugins
**/.flutter-plugins-dependencies

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# secret: FCM service account
apps/backend/config/firebase-service-account.json
config/firebase-service-account.json

# Published mobile builds. Served off disk by Caddy (see docker-compose
# caddy volumes) - deliberately not committed: a ~78 MB binary per build
# would balloon the repo.
/downloads/

# Local build output
/builds/
*.apk
*.aab

# apps/user_app (Flutter customer app) and apps/vsmartlanding (Next.js marketing
# site) used to be nested standalone git repos excluded from here. As of
# 2026-08-07 they are absorbed into this monorepo — their own .gitignore files
# still apply on top of this one.

# Flutter tooling that lands inside apps/user_app
**/.flutter-plugins-dependencies
**/.symlinks/
**/Pods/
*.iml
